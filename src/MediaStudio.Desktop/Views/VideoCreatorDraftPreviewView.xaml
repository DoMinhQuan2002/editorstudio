<UserControl x:Class="MediaStudio.Desktop.Views.VideoCreatorDraftPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaStudio.Desktop.ViewModels"
             xmlns:views="clr-namespace:MediaStudio.Desktop.Views"
             AutomationProperties.AutomationId="VideoCreatorDraftPreview">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MediaStudio.Desktop;component/Themes/VideoEditorImplicit.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style x:Key="PreviewActionButton" TargetType="Button" BasedOn="{StaticResource VE.SecondaryButton}">
                <Setter Property="Foreground" Value="{StaticResource VE.Primary}" />
                <Setter Property="BorderBrush" Value="{StaticResource VE.Border}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="44" />
            </Style>
            <Style x:Key="PreviewCardBorder" TargetType="Border" BasedOn="{StaticResource VE.Card}" />

            <!-- Card-style expander: title + chevron header, content below -->
            <Style x:Key="CardExpander" TargetType="Expander">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border x:Name="Card" Background="White" BorderBrush="{StaticResource VE.Border}" BorderThickness="1" CornerRadius="16">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Cursor="Hand" Focusable="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="20,16,18,14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                                        <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource VE.IconFont}"
                                                                   FontSize="13" Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Top" Margin="10,6,0,0" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="Body" Margin="20,0,20,18" Visibility="Collapsed" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource VE.PrimaryBorder}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource VE.TextSecondary}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="110" />
            </Style>
            <Style x:Key="FieldValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource VE.TextSecondary}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="52" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource VE.Page}" Margin="22,14,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button Command="{Binding BackCommand}" Style="{StaticResource VE.OutlineAccentButton}" MinHeight="40" Padding="16,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.AutomationId="DraftPreviewBack">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource VE.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Quay lại" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,6,0,12">
            <TextBlock Text="Xem và chỉnh sửa kết quả" Style="{StaticResource VE.PageTitle}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Preview được dựng từ Project V2 và Composition Graph. Các mục bên dưới chỉ mở khi template và renderer hỗ trợ."
                       Style="{StaticResource VE.PageSubtitle}" FontSize="14" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" MinWidth="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="0.95*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#11131A" CornerRadius="14" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="320" Height="568" Background="#0E0E12" ClipToBounds="True">
                        <Grid Background="#111116">
                            <Image Source="{Binding PreviewFrame}" Stretch="Uniform" />
                            <MediaElement x:Name="PreviewPlayer" Source="{Binding PreviewVideoUri}"
                                          LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                          ScrubbingEnabled="True"
                                          MediaOpened="OnPreviewMediaOpened" MediaFailed="OnPreviewMediaFailed" MediaEnded="OnPreviewMediaEnded"
                                          AutomationProperties.AutomationId="ComposedDraftPlayer" />
                            <!-- Unsaved size/position edit, rendered as a still over the player. -->
                            <Image Source="{Binding AdjustmentPreviewFrame}" Stretch="Uniform"
                                   Visibility="{Binding IsAdjustmentPreviewVisible, Converter={StaticResource BoolVisibility}}"
                                   AutomationProperties.AutomationId="OverlayAdjustmentPreview" />
                            <!-- Clicking the paused preview opens direct editing of the cut-out on screen.
                                 The bottom margin leaves the playback bar clickable. -->
                            <Border Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="OnPreviewSurfaceClick"
                                    ToolTip="Bấm vào ảnh để kéo, phóng to/thu nhỏ trực tiếp"
                                    AutomationProperties.AutomationId="PreviewEditHitArea" />
                            <!-- Direct manipulation of the selected cut-out (CapCut style). -->
                            <Viewbox Stretch="Uniform"
                                     Visibility="{Binding IsOverlayEditing, Converter={StaticResource BoolVisibility}}">
                                <Canvas x:Name="EditCanvas" Width="1080" Height="1920" ClipToBounds="True" Background="#111116"
                                        Cursor="SizeAll" Focusable="True"
                                        MouseLeftButtonDown="OnEditMouseDown" MouseMove="OnEditMouseMove"
                                        MouseLeftButtonUp="OnEditMouseUp" LostMouseCapture="OnEditLostCapture"
                                        MouseWheel="OnEditMouseWheel" KeyDown="OnEditKeyDown"
                                        AutomationProperties.AutomationId="OverlayEditSurface">
                                    <Image x:Name="EditBackground" Width="1080" Height="1920" Stretch="Fill" IsHitTestVisible="False" />
                                    <Image x:Name="EditLayerImage" Stretch="Fill" IsHitTestVisible="False" />
                                    <Line x:Name="GuideVertical" Stroke="#00E5FF" StrokeThickness="5" IsHitTestVisible="False"
                                          Visibility="Collapsed" />
                                    <Line x:Name="GuideHorizontal" Stroke="#00E5FF" StrokeThickness="5" IsHitTestVisible="False"
                                          Visibility="Collapsed" />
                                    <Rectangle x:Name="SelectionBox" Stroke="White" StrokeThickness="4" StrokeDashArray="3 2"
                                               IsHitTestVisible="False" />
                                    <Ellipse x:Name="HandleTopLeft" Width="54" Height="54" Fill="White" Stroke="#6455F5" StrokeThickness="5" IsHitTestVisible="False" />
                                    <Ellipse x:Name="HandleTopRight" Width="54" Height="54" Fill="White" Stroke="#6455F5" StrokeThickness="5" IsHitTestVisible="False" />
                                    <Ellipse x:Name="HandleBottomLeft" Width="54" Height="54" Fill="White" Stroke="#6455F5" StrokeThickness="5" IsHitTestVisible="False" />
                                    <Ellipse x:Name="HandleBottomRight" Width="54" Height="54" Fill="White" Stroke="#6455F5" StrokeThickness="5" IsHitTestVisible="False" />
                                </Canvas>
                            </Viewbox>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#B31E1E28"
                                    CornerRadius="6" Padding="10,6"
                                    Visibility="{Binding IsLoadingOverlayEdit, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="Đang chuẩn bị ảnh để chỉnh…" Foreground="White" FontSize="11" />
                            </Border>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Background="#B31E1E28"
                                    CornerRadius="6" Padding="8,4" Margin="0,8,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="Đang cập nhật preview…" Foreground="White" FontSize="10" />
                            </Border>
                        </Grid>
                    </Border>
                </Viewbox>
                    <Border Grid.Row="1" Background="#151821" Padding="16,8,16,10">
                <StackPanel>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding DurationSeconds}"
                            Value="{Binding CurrentSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsMoveToPointEnabled="True" Height="18" Margin="0,0,0,6" Style="{StaticResource VE.PlayerSlider}"
                            PreviewMouseLeftButtonDown="OnSeekStarted" PreviewMouseLeftButtonUp="OnSeekCompleted"
                            ValueChanged="OnSeekSliderValueChanged"
                            AutomationProperties.Name="Tua video" />
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="PlayPauseButton" Click="OnPlayPauseToggle" Width="30" Height="30"
                                    AutomationProperties.AutomationId="PlayDraftPreview">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource VE.PlayerIconButton}">
                                        <Setter Property="ToolTip" Value="Phát video" />
                                        <Setter Property="AutomationProperties.Name" Value="Phát video" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="White" CornerRadius="15">
                                                        <TextBlock x:Name="Glyph" Text="&#xE768;" FontFamily="{StaticResource VE.IconFont}" FontSize="12"
                                                                   Foreground="#13131A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE769;" />
                                                            <Setter TargetName="Glyph" Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="ToolTip" Value="Tạm dừng" />
                                                <Setter Property="AutomationProperties.Name" Value="Tạm dừng" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Click="OnPause" Width="0" Height="0" Visibility="Collapsed" AutomationProperties.AutomationId="PauseDraftPreview" />
                            <ToggleButton IsChecked="{Binding IsPreviewMuted}" Width="30" Height="30" Margin="6,0,6,0" Cursor="Hand"
                                          ToolTip="Tắt tiếng xem" AutomationProperties.Name="Tắt tiếng xem">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <TextBlock x:Name="Glyph" Text="&#xE767;" FontFamily="{StaticResource VE.IconFont}" FontSize="15"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE74F;" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Text="{Binding CurrentTimeLabel}" Foreground="White" VerticalAlignment="Center" FontSize="13" />
                            <TextBlock Text=" / " Foreground="#B9B9C2" VerticalAlignment="Center" FontSize="13" />
                            <TextBlock Text="{Binding DurationLabel}" Foreground="White" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE740;" Click="OnFullscreen" Style="{StaticResource VE.PlayerIconButton}"
                                Width="30" Height="30" FontSize="14" ToolTip="Toàn màn hình" AutomationProperties.AutomationId="FullscreenDraftPreview" />
                    </DockPanel>
                </StackPanel>
            </Border>
            </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <!-- Draft summary -->
                    <Border Style="{StaticResource PreviewCardBorder}" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="62" Height="94" CornerRadius="8" Background="#EEEFF5" ClipToBounds="True">
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PreviewFrame}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TemplateName}" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource VE.Text}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TemplateId}" FontSize="14" Foreground="{StaticResource VE.Muted}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding TemplateVersion}" FontSize="14" Foreground="{StaticResource VE.Muted}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding RevisionLabel}" FontSize="14" Foreground="{StaticResource VE.Primary}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" /></Grid.RowDefinitions>
                                <TextBlock Text="&#xE823;" Style="{StaticResource VE.Icon}" Foreground="{StaticResource VE.Muted}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="{Binding DurationLabel}" FontSize="14" Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="&#xE7F4;" Style="{StaticResource VE.Icon}" Foreground="{StaticResource VE.Muted}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AspectRatioLabel}" FontSize="14" Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="&#xE7F8;" Style="{StaticResource VE.Icon}" Foreground="{StaticResource VE.Muted}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResolutionLabel}" FontSize="14" Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Quick settings -->
                    <Border Style="{StaticResource PreviewCardBorder}" Padding="20,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Thiết lập nhanh" Style="{StaticResource VE.CardTitle}" Margin="0,0,0,12" />
                            <DockPanel>
                                <TextBlock Text="Âm lượng" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding AudioVolumeLabel}" DockPanel.Dock="Right" Style="{StaticResource FieldValue}" />
                                <Slider Minimum="0" Maximum="100" Value="{Binding PendingAudioVolume, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsAudioSettingsAvailable}" VerticalAlignment="Center" Margin="0,0,10,0"
                                        AutomationProperties.Name="Âm lượng nhạc nền" />
                            </DockPanel>
                            <CheckBox Content="Tắt tiếng track nhạc của bản nháp" IsChecked="{Binding PendingAudioMuted}"
                                      IsEnabled="{Binding IsAudioSettingsAvailable}" Margin="0,14,0,6" />
                            <TextBlock Text="{Binding AudioUnavailableReason}" Style="{StaticResource VE.Caption}" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Text / sticker -->
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="False" Margin="0,0,0,12">
                        <Expander.Header>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Văn bản / Sticker" Style="{StaticResource VE.CardTitle}" />
                                    <TextBlock Text="&#xE946;" Style="{StaticResource VE.Icon}" FontSize="15" Foreground="{StaticResource VE.Muted}" Margin="10,2,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding TextUnavailableReason}" Style="{StaticResource VE.Caption}" FontSize="13" Margin="0,6,0,0" />
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Mẫu hiện tại chưa có lớp chữ hay sticker chỉnh được." Style="{StaticResource VE.Caption}" FontSize="13" />
                    </Expander>

                    <!-- Cut-out adjustments -->
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="True"
                              Visibility="{Binding HasOverlays, Converter={StaticResource BoolVisibility}}">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Ảnh tách nền" Style="{StaticResource VE.CardTitle}" />
                                <TextBlock Text="Bấm thẳng vào ảnh trên khung preview (hoặc chọn ảnh từ danh sách bên dưới), kéo ảnh để di chuyển, kéo chấm ở góc hoặc lăn chuột để phóng to/thu nhỏ. Đưa ảnh về giữa sẽ hiện đường căn và tự hút vào tâm (giữ Alt để tắt). Bấm Lưu bản nháp để áp dụng."
                                           Style="{StaticResource VE.Caption}" FontSize="13" LineHeight="20" Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding Overlays}" SelectedItem="{Binding SelectedOverlay}"
                                      DisplayMemberPath="Label" Margin="0,0,0,14"
                                      AutomationProperties.AutomationId="OverlayAdjustmentPicker" />
                            <StackPanel DataContext="{Binding SelectedOverlay}"
                                        Visibility="{Binding DataContext.HasSelectedOverlay, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}">
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Kích thước" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SizeLabel}" DockPanel.Dock="Right" Style="{StaticResource FieldValue}" />
                                    <Slider Minimum="20" Maximum="250" SmallChange="1" LargeChange="10" Margin="0,0,10,0"
                                            Value="{Binding SizePercent, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center" AutomationProperties.Name="Kích thước ảnh tách nền" />
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Ngang" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding OffsetXLabel}" DockPanel.Dock="Right" Style="{StaticResource FieldValue}" />
                                    <Slider Minimum="-60" Maximum="60" SmallChange="1" LargeChange="5" Margin="0,0,10,0"
                                            Value="{Binding OffsetXPercent, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center" AutomationProperties.Name="Dịch ảnh sang trái hoặc phải" />
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Dọc" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding OffsetYLabel}" DockPanel.Dock="Right" Style="{StaticResource FieldValue}" />
                                    <Slider Minimum="-60" Maximum="60" SmallChange="1" LargeChange="5" Margin="0,0,10,0"
                                            Value="{Binding OffsetYPercent, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center" AutomationProperties.Name="Dịch ảnh lên hoặc xuống" />
                                </DockPanel>
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Command="{Binding StartOverlayEditCommand}" Style="{StaticResource VE.PrimaryButton}" MinHeight="46"
                                        Padding="12,0" AutomationProperties.AutomationId="StartOverlayEdit">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C2;" FontFamily="{StaticResource VE.IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Chỉnh trên khung hình" FontSize="15" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding FinishOverlayEditCommand}" Style="{StaticResource PreviewActionButton}"
                                        MinHeight="46" Padding="12,0" AutomationProperties.AutomationId="FinishOverlayEdit">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource VE.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Xong" FontSize="15" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Command="{Binding ResetOverlayCommand}" Style="{StaticResource PreviewActionButton}" MinHeight="44" Padding="10,0"
                                        ToolTip="Đưa ảnh đang chọn về kích thước và vị trí mẫu tự đặt">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource VE.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0" />
                                        <TextBlock Text="Về mặc định của mẫu" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding DiscardOverlayChangesCommand}" Style="{StaticResource VE.SecondaryButton}"
                                        MinHeight="44" Padding="10,0" ToolTip="Bỏ mọi chỉnh sửa ảnh chưa lưu">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource VE.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0" />
                                        <TextBlock Text="Hủy thay đổi" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- Save state -->
                    <Grid Margin="4,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource VE.Success}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource VE.IconFont}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SaveStatusLabel}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource VE.SuccessText}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource VE.Caption}" FontSize="13" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource VE.Danger}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource PreviewCardBorder}" Padding="16,10,16,12" Margin="0,12,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SceneCountLabel}" Style="{StaticResource VE.CardTitle}" Margin="2,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource VE.CircleButton}" Click="OnScenesLeft" Margin="0,0,10,0" ToolTip="Cảnh trước">
                        <TextBlock Text="&#xE76B;" FontFamily="{StaticResource VE.IconFont}" FontSize="12" />
                    </Button>
                    <ScrollViewer Grid.Column="1" x:Name="SceneScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Scenes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VideoCreatorPreviewSceneViewModel}">
                                    <Button Command="{Binding DataContext.SelectSceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Width="180" Height="70" Margin="0,0,12,0"
                                            ToolTip="Chuyển preview đến cảnh này" AutomationProperties.Name="{Binding Label}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Chrome" Background="White" BorderBrush="{StaticResource VE.Border}" BorderThickness="1"
                                                        CornerRadius="10" Padding="4" Cursor="Hand">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Border CornerRadius="7" Background="#ECECF2">
                                                            <Grid>
                                                                <Border CornerRadius="7">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                    </Border.Background>
                                                                </Border>
                                                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" CornerRadius="5"
                                                                        Background="#CC13131A" Padding="5,1"
                                                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolVisibility}}">
                                                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource VE.Text}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DurationLabel}" FontSize="12" Foreground="{StaticResource VE.Muted}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource VE.PrimaryBorder}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource VE.Primary}" />
                                                        <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Column="2" Style="{StaticResource VE.CircleButton}" Click="OnScenesRight" Margin="10,0,0,0" ToolTip="Cảnh sau">
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource VE.IconFont}" FontSize="12" />
                    </Button>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Command="{Binding ReplaceMediaCommand}" Style="{StaticResource PreviewActionButton}" MinHeight="44" Padding="20,0"
                    HorizontalAlignment="Left" ToolTip="{Binding ReplacementDisabledReason}"
                    AutomationProperties.AutomationId="ReplaceDraftMedia">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource VE.IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Thay media" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{Binding SaveDraftCommand}" Style="{StaticResource VE.SecondaryButton}" MinHeight="44"
                    Padding="20,0" Margin="0,0,12,0" AutomationProperties.AutomationId="SaveDraft">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource VE.IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Lưu bản nháp" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" Style="{StaticResource VE.PrimaryButton}"
                    MinHeight="44" Padding="24,0" ToolTip="{Binding NextDisabledReason}" AutomationProperties.AutomationId="GoToVideoExport">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tiếp theo: Xuất video" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource VE.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="12,1,0,0" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>

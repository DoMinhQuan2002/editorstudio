<UserControl x:Class="MediaStudio.Desktop.Views.VideoCreatorProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MediaStudio.Desktop.Views">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/MediaStudio.Desktop;component/Themes/VideoEditorImplicit.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <LinearGradientBrush x:Key="RingGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8A7DFF" Offset="0" />
            <GradientStop Color="#4D3DF2" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ProcessingAccentBrush" Color="#5C4BFF" />
        <SolidColorBrush x:Key="ProcessingMutedBrush" Color="#69718A" />
        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#70778D" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <DataTemplate x:Key="ProcessingStageTemplate">
            <Border x:Name="Row" Background="#F5F5FB" CornerRadius="12" Padding="16,0" Margin="0,0,0,8" MinHeight="54"
                    ToolTip="{Binding Message}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StageBadge" Width="36" Height="36" CornerRadius="18"
                            Background="#E7E8F0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="StageGlyph" Text="{Binding Glyph}" FontSize="17" FontWeight="Bold"
                                   Foreground="#9EA3B5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <views:ProgressRing x:Name="StageSpinner" Width="32" Height="32" Thickness="3"
                                        IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StageName" Text="{Binding Name}" FontSize="18" Foreground="{StaticResource VE.Text}" />
                        <TextBlock x:Name="StageMessage" Text="{Binding Message}" FontSize="12"
                                   Foreground="#787D8D" TextWrapping="Wrap" MaxWidth="380" Visibility="Collapsed" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border x:Name="TrailBadge" Grid.Column="2" Width="28" Height="28" CornerRadius="14" Background="#ECEAFE"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="TrailGlyph" Text="&#xE73E;" FontFamily="{StaticResource VE.IconFont}" FontSize="12"
                                   Foreground="{StaticResource VE.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="COMPLETED">
                    <Setter TargetName="StageBadge" Property="Background" Value="#5A4CFA" />
                    <Setter TargetName="StageGlyph" Property="Foreground" Value="White" />
                    <Setter TargetName="TrailBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="RUNNING">
                    <Setter TargetName="StageBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="StageSpinner" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StageSpinner" Property="IsActive" Value="True" />
                    <Setter TargetName="Row" Property="Background" Value="#F0EEFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="SKIPPED">
                    <Setter TargetName="StageName" Property="Foreground" Value="#8A8FA3" />
                    <Setter TargetName="TrailBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TrailBadge" Property="Background" Value="#ECEDF2" />
                    <Setter TargetName="TrailGlyph" Property="Text" Value="&#xE738;" />
                    <Setter TargetName="TrailGlyph" Property="Foreground" Value="#A2A6B6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="FAILED">
                    <Setter TargetName="StageBadge" Property="Background" Value="#FCE9EA" />
                    <Setter TargetName="StageGlyph" Property="Foreground" Value="#B63243" />
                    <Setter TargetName="StageMessage" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Row" Property="Background" Value="#FDF3F4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource VE.Page}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource VE.Border}" BorderThickness="1,1,1,0"
                CornerRadius="18,18,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding BackCommand}" Style="{StaticResource VE.OutlineAccentButton}"
                        MinHeight="32" Padding="12,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ProcessingBack">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource VE.IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="Quay lại" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource VE.Border}" BorderThickness="1,0,1,1"
                CornerRadius="0,0,18,18" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="560" Margin="22,20">
                    <StackPanel Width="660" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="222" Height="222" HorizontalAlignment="Center" Margin="0,0,0,22">
                            <views:ProgressRing Progress="{Binding ProgressPercent}" Thickness="20" RingBrush="{StaticResource RingGradient}"
                                                TrackBrush="#ECEAFE" IsActive="{Binding IsProcessingActive}">
                                <views:ProgressRing.Style>
                                    <Style TargetType="views:ProgressRing">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter Property="RingBrush" Value="#B63243" />
                                                <Setter Property="TrackBrush" Value="#F8E2E5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:ProgressRing.Style>
                            </views:ProgressRing>
                            <TextBlock Text="{Binding ProgressLabel}" FontSize="46" FontWeight="Bold"
                                       Foreground="#1D2435" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProgressPercent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding Heading}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource VE.Text}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{Binding Description}" FontSize="18" Foreground="{StaticResource VE.Muted}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" Margin="0,10,0,0" />
                        <ItemsControl ItemsSource="{Binding Stages}" ItemTemplate="{StaticResource ProcessingStageTemplate}"
                                      Width="460" HorizontalAlignment="Center" Margin="0,26,0,0" />

                        <Border Background="#FCEDEE" BorderBrush="#F0C5C9" BorderThickness="1" CornerRadius="8"
                                Padding="12,9" Margin="0,14,0,0" MaxWidth="550">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#912F3D" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorCode}" Foreground="#912F3D" FontSize="11" Margin="0,3,0,0" />
                                <Button Content="Thử lại" Command="{Binding RetryCommand}" HorizontalAlignment="Right"
                                        Padding="12,5" Margin="0,7,0,0" Background="White" Foreground="#5144E8"
                                        BorderBrush="#D9DCEF" AutomationProperties.AutomationId="RetryTemplateProcessing" />
                            </StackPanel>
                        </Border>

                        <Border Background="#EEF6F1" BorderBrush="#D8E9DE" BorderThickness="1" CornerRadius="8"
                                Padding="12,10" Margin="0,14,0,0" MaxWidth="550">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding HandoffMessage}" Foreground="#42614C" TextWrapping="Wrap" />
                                <Button Content="Mở lại kết quả" Command="{Binding OpenDraftPreviewCommand}"
                                        HorizontalAlignment="Right" Padding="12,6" Margin="0,8,0,0"
                                        Background="White" Foreground="#5144E8" BorderBrush="#D9DCEF"
                                        AutomationProperties.AutomationId="OpenDraftPreview" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding ConnectionMessage}" Foreground="#9A5B23" FontSize="12"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="550" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

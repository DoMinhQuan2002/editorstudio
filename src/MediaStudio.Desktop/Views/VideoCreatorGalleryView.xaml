<UserControl x:Class="MediaStudio.Desktop.Views.VideoCreatorGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaStudio.Desktop.ViewModels"
             xmlns:views="clr-namespace:MediaStudio.Desktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Loaded="OnLoaded"
             AutomationProperties.AutomationId="VideoTemplateGallery">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MediaStudio.Desktop;component/Themes/VideoEditorImplicit.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:LocalPosterImageConverter x:Key="LocalPosterImageConverter" />
            <views:CategoryStyleConverter x:Key="CategoryStyle" />
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />

            <!-- Template card: poster on top, title, two-line description, category pill -->
            <Style x:Key="TemplateCardButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource VE.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityName}" />
                <Setter Property="AutomationProperties.HelpText" Value="Chọn mẫu để xem thông tin. Không tạo dự án khi chọn." />
                <Setter Property="ToolTip" Value="{Binding AccessibilityName}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Style="{StaticResource VE.CardShadowLayer}" />
                                <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="16" Padding="9">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource VE.PrimaryBorder}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource VE.Primary}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource VE.Primary}" />
                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="CardBorder" Property="Padding" Value="8" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="CardBorder" Property="Opacity" Value="0.62" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ViewToggleButton" TargetType="Button" BasedOn="{StaticResource VE.ButtonBase}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource VE.TextSecondary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource VE.PrimarySoft}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource VE.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Category pill used on cards and the selection bar -->
            <DataTemplate x:Key="CategoryPill">
                <Border CornerRadius="13" Padding="12,4" HorizontalAlignment="Left"
                        Background="{Binding Converter={StaticResource CategoryStyle}, ConverterParameter=bg}">
                    <TextBlock Text="{Binding}" FontSize="13" FontWeight="Medium"
                               Foreground="{Binding Converter={StaticResource CategoryStyle}, ConverterParameter=fg}" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource VE.Page}">
        <Grid Margin="28,16,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title and search -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="410" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Chọn mẫu video" Style="{StaticResource VE.PageTitle}" FontSize="34" FontWeight="Bold" />
                    <TextBlock Text="Chọn một mẫu phù hợp, sau đó thêm ảnh và video của bạn để tạo video tự động."
                               Style="{StaticResource VE.PageSubtitle}" FontSize="15" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Height="48" VerticalAlignment="Center" Background="White"
                        BorderBrush="{StaticResource VE.Border}" BorderThickness="1" CornerRadius="12">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" Style="{StaticResource VE.Icon}" FontSize="17" Foreground="{StaticResource VE.TextSecondary}" />
                        <Grid Grid.Column="2">
                            <TextBlock Text="Tìm kiếm mẫu video..." FontSize="16" Foreground="{StaticResource VE.Subtle}"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox AutomationProperties.Name="Tìm kiếm mẫu"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center" VerticalAlignment="Stretch"
                                     FontSize="16" Foreground="{StaticResource VE.Text}"
                                     ToolTip="Tìm theo tên, mô tả hoặc danh mục" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Categories, catalog status, grid/list toggle -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Categories}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VideoTemplateCategoryViewModel}">
                            <Button Style="{StaticResource VE.ChipButton}" Tag="{Binding IsSelected}"
                                    AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Name}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ChipIcon" Text="{Binding Name, Converter={StaticResource CategoryStyle}, ConverterParameter=icon}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji" FontSize="16"
                                               Foreground="{Binding Name, Converter={StaticResource CategoryStyle}, ConverterParameter=iconBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Visibility="{Binding Name, Converter={StaticResource CategoryStyle}, ConverterParameter=iconVisibility}" />
                                    <TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="ChipIcon" Property="Foreground" Value="White" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="1" Text="{Binding CatalogStatus}" FontSize="14" Foreground="{StaticResource VE.Muted}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="16,0,20,0" />
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource VE.Border}" BorderThickness="1"
                        CornerRadius="12" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ViewToggleButton}" Tag="{Binding IsGridView}" Command="{Binding ShowGridCommand}"
                                ToolTip="Dạng lưới" AutomationProperties.Name="Xem dạng lưới">
                            <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource VE.IconFont}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource ViewToggleButton}" Tag="{Binding IsListView}" Command="{Binding ShowListCommand}"
                                Margin="4,0,0,0" ToolTip="Dạng danh sách" AutomationProperties.Name="Xem dạng danh sách">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource VE.IconFont}" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Catalog; scrolls on its own above the pinned selection bar -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Danh sách mẫu video"
                              Visibility="{Binding IsGridView, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl ItemsSource="{Binding VisibleTemplates}" AutomationProperties.AutomationId="TemplateGrid" Margin="0,0,6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:ResponsiveGalleryPanel MinItemWidth="200" ItemSpacing="16" MaxColumns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VideoTemplateCardViewModel}">
                                <Button Style="{StaticResource TemplateCardButtonStyle}" Margin="0,0,0,16"
                                        Command="{Binding DataContext.SelectTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <views:AspectFrame Grid.Row="0" HeightPerWidth="1.95">
                                            <Border CornerRadius="11" Background="#EEEFF5" ClipToBounds="True">
                                                <Grid>
                                                    <Border CornerRadius="11">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding PosterPath, Converter={StaticResource LocalPosterImageConverter}}"
                                                                        Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- Placeholder only when the catalog has no poster -->
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{Binding HasNoPoster, Converter={StaticResource BoolVisibility}}">
                                                        <TextBlock Text="&#xEB9F;" Style="{StaticResource VE.Icon}" FontSize="46" Foreground="#B7BACB" />
                                                        <TextBlock Text="Chưa có poster" FontSize="15" Foreground="{StaticResource VE.Muted}"
                                                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                                                        <TextBlock Text="{Binding AspectRatio}" FontSize="15" Foreground="{StaticResource VE.Muted}"
                                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>

                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" CornerRadius="15"
                                                            Padding="12,4" BorderBrush="White" BorderThickness="1.5"
                                                            Background="{Binding Category, Converter={StaticResource CategoryStyle}, ConverterParameter=bg}">
                                                        <TextBlock Text="{Binding Category}" FontSize="13" FontWeight="Medium"
                                                                   Foreground="{Binding Category, Converter={StaticResource CategoryStyle}, ConverterParameter=fg}" />
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" CornerRadius="15"
                                                            Padding="10,4" Background="White">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE81E;" FontFamily="{StaticResource VE.IconFont}" FontSize="14"
                                                                       Foreground="{StaticResource VE.Text}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding SceneCount, StringFormat={}{0} cảnh}" FontSize="13" FontWeight="Medium"
                                                                       Foreground="{StaticResource VE.Text}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </views:AspectFrame>

                                        <StackPanel Grid.Row="1" Margin="4,12,4,2">
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{StaticResource VE.Text}" TextTrimming="CharacterEllipsis"
                                                       AutomationProperties.Name="{Binding Name}" />
                                            <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{StaticResource VE.Muted}"
                                                       Margin="0,6,0,0" Height="40" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            <ContentPresenter Content="{Binding Category}" ContentTemplate="{StaticResource CategoryPill}"
                                                              Margin="0,10,0,2" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- List view -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsListView, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl ItemsSource="{Binding VisibleTemplates}" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VideoTemplateCardViewModel}">
                                <Button Style="{StaticResource TemplateCardButtonStyle}" Margin="0,0,0,12"
                                        Command="{Binding DataContext.SelectTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Height="104" CornerRadius="10" Background="#EEEFF5">
                                            <Grid>
                                                <Border CornerRadius="10">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding PosterPath, Converter={StaticResource LocalPosterImageConverter}}"
                                                                    Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="&#xE8B9;" Style="{StaticResource VE.Icon}" FontSize="26" Foreground="#B7BACB"
                                                           Visibility="{Binding HasNoPoster, Converter={StaticResource BoolVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource VE.Text}" />
                                            <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{StaticResource VE.Muted}"
                                                       Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                <ContentPresenter Content="{Binding Category}" ContentTemplate="{StaticResource CategoryPill}" />
                                                <TextBlock Text="{Binding RequiredMediaSlotsText}" FontSize="13" Foreground="{StaticResource VE.Muted}"
                                                           VerticalAlignment="Center" Margin="14,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="3" CornerRadius="15" Padding="12,5" Background="{StaticResource VE.SurfaceMuted}"
                                                VerticalAlignment="Center" Margin="12,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE81E;" FontFamily="{StaticResource VE.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding SceneCount, StringFormat={}{0} cảnh}" FontSize="14" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasNoVisibleTemplates, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{Binding EmptyStateTitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource VE.Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyStateDescription}" FontSize="14" Foreground="{StaticResource VE.Muted}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button HorizontalAlignment="Center" Margin="0,16,0,0"
                            Command="{Binding RetryLoadCommand}" AutomationProperties.AutomationId="RetryTemplateCatalog">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VE.SecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCatalogLoadFailed}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Thử tải lại catalog" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Pinned selection bar -->
            <Border Grid.Row="3" Style="{StaticResource VE.Card}" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="62" Height="80" CornerRadius="8" Background="#EEEFF5" ClipToBounds="True">
                            <Grid>
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding SelectedTemplatePosterPath, Converter={StaticResource LocalPosterImageConverter}}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border VerticalAlignment="Bottom" Background="#F2FFFFFF" CornerRadius="0,0,8,8" Padding="0,2">
                                    <TextBlock Text="9:16" FontSize="12" Foreground="{StaticResource VE.TextSecondary}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTemplateName}" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{StaticResource VE.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <ContentPresenter Content="{Binding SelectedTemplateCategory}" ContentTemplate="{StaticResource CategoryPill}"
                                                  Margin="16,0,0,0" VerticalAlignment="Center"
                                                  Visibility="{Binding HasSelectedTemplate, Converter={StaticResource BoolVisibility}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0"
                                        Visibility="{Binding HasSelectedTemplate, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource VE.IconFont}" FontSize="16" Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedTemplateMediaText}" FontSize="15" Foreground="{StaticResource VE.TextSecondary}" Margin="10,0,34,0" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE823;" FontFamily="{StaticResource VE.IconFont}" FontSize="16" Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedTemplateDuration}" FontSize="15" Foreground="{StaticResource VE.TextSecondary}" Margin="10,0,34,0" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource VE.IconFont}" FontSize="16" Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedTemplateAspect}" FontSize="15" Foreground="{StaticResource VE.TextSecondary}" Margin="10,0,34,0" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource VE.IconFont}" FontSize="16" Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedTemplateResolution}" FontSize="15" Foreground="{StaticResource VE.TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedTemplateSummary}" FontSize="14" Foreground="{StaticResource VE.Muted}" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedTemplate}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource VE.SecondaryButton}" MinWidth="168" MinHeight="54"
                                Command="{Binding OpenLatestDraftCommand}" IsEnabled="{Binding HasLatestSavedDraft}"
                                ToolTip="{Binding LatestSavedDraftLabel}" AutomationProperties.AutomationId="OpenLatestTemplateDraft">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource VE.IconFont}" FontSize="17" VerticalAlignment="Center" Margin="0,0,11,0" />
                                <TextBlock Text="Mở dự án" FontSize="16" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource VE.PrimaryButton}" MinWidth="204" MinHeight="54"
                                Margin="16,0,0,0" Command="{Binding UseTemplateCommand}"
                                IsEnabled="{Binding CanUseTemplate}"
                                AutomationProperties.AutomationId="UseSelectedTemplate"
                                ToolTip="Mở chi tiết mẫu; thao tác này chưa tạo dự án hoặc gán media.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Xem chi tiết" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE72A;" FontFamily="{StaticResource VE.IconFont}" FontSize="15" VerticalAlignment="Center" Margin="14,1,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

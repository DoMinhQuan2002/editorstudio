<UserControl x:Class="MediaStudio.Desktop.Views.UpscaleToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MediaStudio.Desktop.Views"
             MinHeight="538">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.376*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="62" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▧" FontSize="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding InputFileName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding InputDimensions}" Style="{StaticResource SmallTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenImageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▱" FontSize="16" Margin="0,0,7,0" />
                            <TextBlock Text="Đổi ảnh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource CanvasBrush}" Padding="16">
                    <Border CornerRadius="8" Background="#D6E0E1" ClipToBounds="True" Margin="44,0">
                        <Grid x:Name="ComparisonSurface" ClipToBounds="True" SizeChanged="ComparisonSurface_OnSizeChanged">
                            <Viewbox Stretch="Uniform"><views:LandscapeArtwork /></Viewbox>
                            <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                   Visibility="{Binding HasImportedImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid x:Name="ResultPreviewClip" ClipToBounds="True"
                                  Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="{Binding ResultPreviewImage}" Stretch="UniformToFill" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Rectangle x:Name="BeforeTint" Grid.ColumnSpan="2" Fill="#24191D1D" IsHitTestVisible="False" />
                                <Border x:Name="ComparisonDivider" HorizontalAlignment="Left" Width="2" Background="White" Opacity="0.95"
                                        IsHitTestVisible="False" />
                                <Thumb x:Name="ComparisonHandle" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Cursor="SizeWE" DragDelta="ComparisonHandle_OnDragDelta" Panel.ZIndex="1">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="18" Background="White" BorderBrush="#E2E3E8" BorderThickness="1">
                                                <TextBlock Text="↔" FontSize="18" Foreground="{StaticResource PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                                        Background="#C82B3441" CornerRadius="5" Padding="9,5" IsHitTestVisible="False">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="White"><Run Text="Trước  ·  " /><Run Text="{Binding PixelDimensions, Mode=OneWay}" /></TextBlock>
                                </Border>
                                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
                                        Background="#C82B3441" CornerRadius="5" Padding="9,5" IsHitTestVisible="False">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="White">
                                        <Run Text="Sau  ·  " /><Run Text="{Binding ScaleFactor}" /><Run Text="×" />
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <Grid Grid.Row="2" Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◫" FontSize="17" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="So sánh trước / sau" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Bản xem trước" Style="{StaticResource SmallTextStyle}" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Content="−" IsEnabled="False" />
                        <TextBlock Text="50%" FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="9,0" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Content="+" IsEnabled="False" />
                        <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="12,0" />
                        <TextBlock Text="Vừa khung" Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="14" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="Thiết lập nâng cấp" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="☷" FontSize="18" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="2" Text="Tỷ lệ phóng lớn" Style="{StaticResource SmallTextStyle}" FontWeight="SemiBold" />
                <UniformGrid Grid.Row="4" Columns="3">
                    <Button Content="2×" Margin="0,0,4,0" Command="{Binding SetScaleCommand}" CommandParameter="2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding ScaleFactor}" Value="2"><Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="4×" Margin="2,0" Command="{Binding SetScaleCommand}" CommandParameter="4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding ScaleFactor}" Value="4"><Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="8×" Margin="4,0,0,0" Command="{Binding SetScaleCommand}" CommandParameter="8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding ScaleFactor}" Value="8"><Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>
                <TextBlock Grid.Row="6" Text="{Binding ScaleDescription}" Style="{StaticResource SmallTextStyle}" FontSize="10" />

                <TextBlock Grid.Row="8" Text="Mô hình AI" Style="{StaticResource SmallTextStyle}" FontWeight="SemiBold" />
                <ComboBox Grid.Row="10" SelectedValue="{Binding Model}" SelectedValuePath="Content" Height="38" VerticalContentAlignment="Center"
                          Padding="10,0" FontSize="12" BorderBrush="{StaticResource BorderBrush}" Background="White">
                    <ComboBoxItem Content="Real-ESRGAN" />
                    <ComboBoxItem Content="Real-ESRGAN Anime" />
                </ComboBox>

                <Grid Grid.Row="12">
                    <StackPanel>
                        <TextBlock Text="Khử nhiễu" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="Làm sạch vùng nhiễu và hạt ảnh" Style="{StaticResource SmallTextStyle}" FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleCheckBoxStyle}" IsChecked="{Binding ReduceNoise}" HorizontalAlignment="Right" />
                </Grid>
                <Grid Grid.Row="14">
                    <StackPanel>
                        <TextBlock Text="Tăng độ sắc nét" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="Làm rõ cạnh và chi tiết nhỏ" Style="{StaticResource SmallTextStyle}" FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleCheckBoxStyle}" IsChecked="{Binding Sharpen}" HorizontalAlignment="Right" />
                </Grid>

                <Border Grid.Row="16" Background="{StaticResource BorderBrush}" />
                <Grid Grid.Row="18">
                    <TextBlock Text="Kích thước đầu ra" Style="{StaticResource SmallTextStyle}" />
                    <TextBlock Text="{Binding OutputDimensions}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
                <Grid Grid.Row="20">
                    <TextBlock Text="Định dạng" Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
                    <ComboBox Width="154" Height="34" SelectedValue="{Binding OutputFormat}" SelectedValuePath="Content"
                              HorizontalAlignment="Right" VerticalContentAlignment="Center"
                              Padding="10,0" FontSize="12" BorderBrush="{StaticResource BorderBrush}" Background="White">
                        <ComboBoxItem Content="PNG" /><ComboBoxItem Content="JPG" /><ComboBoxItem Content="TIFF" />
                    </ComboBox>
                </Grid>

                <ProgressBar Grid.Row="21" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,3"
                             Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding ProgressIsIndeterminate, Mode=OneWay}"
                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Grid Grid.Row="22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✧" FontFamily="Segoe UI Symbol" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding RunButtonLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Lưu ảnh"
                            Command="{Binding SaveResultCommand}"
                            Visibility="{Binding ShowSaveButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <TextBlock Grid.Row="24" Text="{Binding StatusMessage}" FontSize="9" Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="MediaStudio.Desktop.Views.DieCutLineToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MediaStudio.Desktop.Views"
             MinHeight="538">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.376*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="62" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▧" FontSize="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding InputFileName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding InputDimensions}" Style="{StaticResource SmallTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenImageCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▱" FontSize="16" Margin="0,0,7,0" /><TextBlock Text="Đổi ảnh" /></StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="16,0">
                    <Border Background="{StaticResource CheckerboardBrush}" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="2" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}">
                                        <Run Text="Đường bế  ·  " /><Run Text="{Binding OffsetMillimeters, StringFormat={}{0:0.0}}" /><Run Text=" mm" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="11" Height="11" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Đường khép kín" FontSize="10" Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" ClipToBounds="True">
                                <Grid Visibility="{Binding ShowSampleArt, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Viewbox Stretch="Uniform" Margin="20">
                                        <Canvas Width="260" Height="280">
                                            <views:FlowerArtwork />
                                            <Path Data="M130,8 C147,5 163,16 165,32 C183,23 203,37 204,55 C224,59 236,79 226,97 C238,111 231,132 213,140 C220,158 208,175 188,178 C181,192 163,197 148,188 L145,200 L177,202 L168,263 C166,275 157,280 145,280 L108,280 C96,280 88,274 85,262 L76,201 L108,198 L108,187 C88,195 69,186 64,169 C45,164 37,145 49,128 C39,111 47,91 66,84 C63,65 76,49 96,49 C100,29 114,13 130,8 Z"
                                                  Fill="Transparent" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2.4" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,26,0"
                                            Background="#D9FFFFFF" BorderBrush="#D7D9E2" BorderThickness="1" CornerRadius="5" Padding="9,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="22" Height="1" Background="#A6A8B2" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Viền cắt ngoài" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Visibility="{Binding HasImportedImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="20" />
                                    <Image Source="{Binding CutLinePreviewImage}" Stretch="Uniform" Margin="20"
                                           Visibility="{Binding ShowCutLinePreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           IsHitTestVisible="False" />
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12" Background="#EFFFFFFF"
                                            CornerRadius="6" Padding="10,6"
                                            Visibility="{Binding ShowCutLinePlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Đường bế sẽ hiện sau khi xử lý" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                    <Canvas x:Name="MaskEditorCanvas" Margin="20" Background="Transparent" Cursor="Cross"
                                            Visibility="{Binding IsMaskEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            IsHitTestVisible="{Binding CanEditSettings}"
                                            MouseLeftButtonDown="MaskEditorCanvas_OnMouseLeftButtonDown"
                                            MouseMove="MaskEditorCanvas_OnMouseMove"
                                            MouseLeftButtonUp="MaskEditorCanvas_OnMouseLeftButtonUp" />
                                </Grid>
                            </Grid>

                            <Border Grid.Row="2" Background="#F0EFFF" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ⓘ" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Kiểm tra đường bế trong bản xem trước trước khi xuất tệp."
                                               FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✂" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Xem đường bế" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Bản xem trước" Style="{StaticResource SmallTextStyle}" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Content="−" IsEnabled="False" />
                        <TextBlock Text="50%" FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="9,0" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Content="+" IsEnabled="False" />
                        <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="12,0" />
                        <TextBlock Text="Vừa khung" Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" /><RowDefinition Height="14" /><RowDefinition Height="32" />
                    <RowDefinition Height="14" /><RowDefinition Height="16" /><RowDefinition Height="8" />
                    <RowDefinition Height="42" /><RowDefinition Height="14" /><RowDefinition Height="32" />
                    <RowDefinition Height="16" /><RowDefinition Height="16" /><RowDefinition Height="8" />
                    <RowDefinition Height="38" /><RowDefinition Height="16" /><RowDefinition Height="32" />
                    <RowDefinition Height="14" /><RowDefinition Height="32" /><RowDefinition Height="16" />
                    <RowDefinition Height="1" /><RowDefinition Height="16" /><RowDefinition Height="18" />
                    <RowDefinition Height="12" /><RowDefinition Height="34" /><RowDefinition Height="*" />
                    <RowDefinition Height="44" /><RowDefinition Height="10" /><RowDefinition Height="14" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"><TextBlock Text="Thiết lập đường bế" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="☷" FontSize="18" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                <Grid Grid.Row="2" IsEnabled="{Binding CanEditSettings}"><StackPanel><TextBlock Text="Tự động nhận diện viền" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="Tìm đường bao ngoài của artwork" Style="{StaticResource SmallTextStyle}" FontSize="10" Margin="0,2,0,0" /></StackPanel>
                    <CheckBox Style="{StaticResource ToggleCheckBoxStyle}" IsChecked="{Binding AutoDetect}" HorizontalAlignment="Right" /></Grid>

                <TextBlock Grid.Row="4" Text="Khoảng cách đường bế" Style="{StaticResource SmallTextStyle}" FontWeight="SemiBold" />
                <Grid Grid.Row="6" IsEnabled="{Binding CanEditSettings}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="−" Style="{StaticResource SegmentButtonStyle}" Command="{Binding AdjustOffsetCommand}" CommandParameter="-0.5" />
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OffsetMillimeters, StringFormat={}{0:0.0}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="mm" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2" Content="+" Style="{StaticResource SegmentButtonStyle}" Command="{Binding AdjustOffsetCommand}" CommandParameter="0.5" />
                </Grid>

                <Grid Grid.Row="8" IsEnabled="{Binding CanEditSettings}"><StackPanel><TextBlock Text="Làm mượt đường bế" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="Giảm điểm gấp trên đường viền" Style="{StaticResource SmallTextStyle}" FontSize="10" Margin="0,2,0,0" /></StackPanel>
                    <CheckBox Style="{StaticResource ToggleCheckBoxStyle}" IsChecked="{Binding SmoothPath}" HorizontalAlignment="Right" /></Grid>

                <TextBlock Grid.Row="10" Text="Độ phức tạp đường" Style="{StaticResource SmallTextStyle}" FontWeight="SemiBold" />
                <UniformGrid Grid.Row="12" Columns="3" IsEnabled="{Binding CanEditSettings}">
                    <Button Content="Đơn giản" Margin="0,0,4,0" Command="{Binding SelectComplexityCommand}" CommandParameter="Đơn giản">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding Complexity}" Value="Đơn giản"><Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="Vừa" Margin="2,0" Command="{Binding SelectComplexityCommand}" CommandParameter="Vừa">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding Complexity}" Value="Vừa"><Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="Chi tiết" Margin="4,0,0,0" Command="{Binding SelectComplexityCommand}" CommandParameter="Chi tiết">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding Complexity}" Value="Chi tiết"><Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </UniformGrid>

                <Border Grid.Row="18" Background="{StaticResource BorderBrush}" />
                <Grid Grid.Row="14" IsEnabled="{Binding CanEditSettings}">
                    <TextBlock Text="Chiều rộng in thực tế" Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox Width="76" Height="30" Text="{Binding ArtworkWidthMillimeters, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Padding="6,0"
                                 FontSize="12" BorderBrush="{StaticResource BorderBrush}" IsEnabled="{Binding CanEditSettings}" />
                        <TextBlock Text="mm" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="15" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                    <Run Text="Kích thước quy đổi: " /><Run Text="{Binding PhysicalSizeSummary, Mode=OneWay}" />
                </TextBlock>
                <Grid Grid.Row="16" IsEnabled="{Binding CanEditSettings}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Hiệu chỉnh mask" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsMaskEditing}" IsEnabled="{Binding CanEditSettings}"
                              HorizontalAlignment="Right" Margin="0,0,8,0"
                              Style="{StaticResource ToggleCheckBoxStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Giữ" Height="28" Margin="2,0" Command="{Binding SelectMaskBrushCommand}"
                            CommandParameter="foreground" ToolTip="Tô lên chủ thể để giữ vùng này">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                            <Setter Property="Foreground" Value="#23865B" />
                            <Style.Triggers><DataTrigger Binding="{Binding MaskBrush}" Value="foreground">
                                <Setter Property="Background" Value="#E9F6EF" /><Setter Property="BorderBrush" Value="#23865B" />
                            </DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <Button Grid.Column="2" Content="Bỏ" Height="28" Margin="2,0" Command="{Binding SelectMaskBrushCommand}"
                            CommandParameter="background" ToolTip="Tô lên nền để loại khỏi vùng cắt">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                            <Setter Property="Foreground" Value="#D94C5C" />
                            <Style.Triggers><DataTrigger Binding="{Binding MaskBrush}" Value="background">
                                <Setter Property="Background" Value="#FFF0F1" /><Setter Property="BorderBrush" Value="#D94C5C" />
                            </DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                </Grid>
                <Grid Grid.Row="17">
                    <TextBlock Text="Tô trực tiếp trên ảnh; xanh giữ chủ thể, đỏ xóa nền."
                               FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <Button Content="Xóa nét" FontSize="9" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding ClearMaskStrokesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <Grid Grid.Row="20"><TextBlock Text="Đầu ra vector" Style="{StaticResource SmallTextStyle}" />
                    <TextBlock Text="{Binding OutputSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" /></Grid>
                <Grid Grid.Row="22"><TextBlock Text="Định dạng" Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
                    <Border Width="154" Height="34" HorizontalAlignment="Right" Background="White"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,0">
                        <TextBlock Text="SVG · đường cắt" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    </Border></Grid>

                <Grid Grid.Row="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding RunCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="✂" FontFamily="Segoe UI Symbol" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding RunButtonLabel}" /></StackPanel>
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasResult}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1" /></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Lưu SVG" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SaveResultCommand}"
                            Visibility="{Binding ShowSaveButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <TextBlock Grid.Row="26" Text="{Binding StatusMessage}" FontSize="9" Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

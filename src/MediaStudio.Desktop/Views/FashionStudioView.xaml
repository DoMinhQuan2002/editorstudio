<UserControl x:Class="MediaStudio.Desktop.Views.FashionStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="FashionStudio">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MediaStudio.Desktop;component/Themes/VideoEditorImplicit.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />

            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource VE.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18,16" />
            </Style>
            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource VE.Text}" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource VE.Text}" />
                <Setter Property="Margin" Value="0,16,0,8" />
            </Style>

            <!-- Task card on the left -->
            <Style x:Key="TaskCard" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="White" BorderBrush="{StaticResource VE.Border}" BorderThickness="1" CornerRadius="12" Padding="12,11">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource VE.PrimaryBorder}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#F3F1FF" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource VE.Primary}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Preset chip -->
            <Style x:Key="PresetChip" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="White" BorderBrush="{StaticResource VE.Border}" BorderThickness="1" CornerRadius="17" Padding="14,7">
                                <TextBlock x:Name="Text" Text="{Binding Label}" FontSize="13" Foreground="{StaticResource VE.Text}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource VE.PrimaryBorder}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource VE.Primary}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource VE.Primary}" />
                                    <Setter TargetName="Text" Property="Foreground" Value="White" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Image drop slot -->
            <Style x:Key="ImageSlot" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="#F7F8FC" BorderBrush="#D5D8E5" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource VE.Primary}" />
                                    <Setter TargetName="Chrome" Property="Background" Value="#F3F1FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource VE.Page}">
        <Grid Margin="24,16,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Fashion Studio" Style="{StaticResource VE.PageTitle}" FontSize="30" FontWeight="Bold" />
                        <Border Background="#FDECF3" CornerRadius="10" Padding="10,3" Margin="12,6,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Qwen-Image AI" FontSize="12" FontWeight="SemiBold" Foreground="#D0457E" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Thử đồ, đổi bối cảnh và tạo biến thể ảnh thời trang cho video của bạn."
                               Style="{StaticResource VE.PageSubtitle}" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16" Padding="12,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFF4E5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Background" Value="#E9F7EF" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#E59A2C" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Fill" Value="#23A35A" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="13" Foreground="{StaticResource VE.Text}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Model chưa sẵn sàng" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Text" Value="Model sẵn sàng" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Setup banner -->
            <Border Grid.Row="1" Background="#FFF8EC" BorderBrush="#F5D9A8" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14"
                    Visibility="{Binding ShowSetupBanner, Converter={StaticResource BoolVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource VE.IconFont}" FontSize="18" Foreground="#C77A12" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cần chuẩn bị model Qwen-Image-Edit" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource VE.Text}" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource VE.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Stage}" FontSize="12" Foreground="{StaticResource VE.Primary}" Margin="0,4,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource VE.SecondaryButton}" MinHeight="38" Padding="14,0" Command="{Binding RefreshStatusCommand}">
                            <TextBlock Text="Kiểm tra lại" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource VE.PrimaryButton}" MinHeight="38" Padding="16,0" Margin="8,0,0,0" Command="{Binding DownloadModelCommand}"
                                Visibility="{Binding CanDownloadModel, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource VE.IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Tải model" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" MinWidth="380" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.05*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- Tasks -->
                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Chức năng" Style="{StaticResource PanelTitle}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TaskCard}" Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource VE.PrimaryTint}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource VE.IconFont}" FontSize="15" Foreground="{StaticResource VE.Primary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource VE.Text}" />
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource VE.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Inputs -->
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <DockPanel>
                        <!-- Generate -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <Border Background="#FDECEC" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{Binding Error}" Foreground="#C0392B" FontSize="13" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource VE.Primary}" Text="{Binding Progress, StringFormat={}{0}%}" />
                                    <TextBlock Text="{Binding Stage}" FontSize="12" Foreground="{StaticResource VE.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate}" Foreground="{StaticResource VE.Primary}" Background="#ECEAF8" BorderThickness="0" />
                            </StackPanel>
                            <Button Style="{StaticResource VE.PrimaryButton}" MinHeight="48" Command="{Binding GenerateCommand}" AutomationProperties.AutomationId="FashionGenerate">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource VE.IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Tạo ảnh" FontSize="16" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding GenerateHint}" FontSize="12" Foreground="{StaticResource VE.Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="{Binding SelectedTask.Title}" Style="{StaticResource PanelTitle}" />
                                <TextBlock Text="{Binding SelectedTask.Description}" FontSize="13" Foreground="{StaticResource VE.Muted}" Margin="0,3,0,0" />

                                <Grid Margin="0,14,0,0" Height="230">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <!-- Person -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Ảnh người mẫu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource VE.Text}" Margin="0,0,0,6" />
                                        <Button Style="{StaticResource ImageSlot}" Command="{Binding PickPersonCommand}" ToolTip="Chọn ảnh người mẫu">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource VE.IconFont}" FontSize="30" Foreground="#A9ADC2" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Bấm để chọn ảnh" FontSize="13" Foreground="{StaticResource VE.Muted}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Ảnh rõ mặt, thấy toàn thân càng tốt" FontSize="11" Foreground="#9AA0B4" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <Image Source="{Binding PersonImage}" Stretch="Uniform" Margin="6" />
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                    <!-- Garment (try-on) -->
                                    <DockPanel Grid.Column="2" Visibility="{Binding IsTryOn, Converter={StaticResource BoolVisibility}}">
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Command="{Binding ClearGarmentCommand}" Cursor="Hand" ToolTip="Bỏ ảnh trang phục"
                                                    Visibility="{Binding HasGarment, Converter={StaticResource BoolVisibility}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock Text="Xóa" FontSize="12" Foreground="{StaticResource VE.Primary}" />
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock Text="Ảnh trang phục" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource VE.Text}" />
                                        </DockPanel>
                                        <Button Style="{StaticResource ImageSlot}" Command="{Binding PickGarmentCommand}" ToolTip="Chọn ảnh sản phẩm">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource VE.IconFont}" FontSize="30" Foreground="#A9ADC2" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Bấm để chọn ảnh" FontSize="13" Foreground="{StaticResource VE.Muted}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Ảnh sản phẩm trên nền trơn" FontSize="11" Foreground="#9AA0B4" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <Image Source="{Binding GarmentImage}" Stretch="Uniform" Margin="6" />
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                </Grid>

                                <!-- Scene -->
                                <StackPanel Visibility="{Binding IsScene, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="Bối cảnh" Style="{StaticResource Label}" />
                                    <ItemsControl ItemsSource="{Binding ScenePresets}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PresetChip}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.SelectSceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Hoặc tự mô tả bối cảnh (tiếng Anh cho kết quả tốt nhất)" FontSize="12" Foreground="{StaticResource VE.Muted}" Margin="0,4,0,6" />
                                    <TextBox Text="{Binding SceneText, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="14" />
                                </StackPanel>

                                <!-- Recolor -->
                                <StackPanel Visibility="{Binding IsRecolor, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="Màu mới" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="14" />
                                    <TextBlock Text="Ví dụ: burgundy red, pastel pink, navy blue, beige" FontSize="12" Foreground="{StaticResource VE.Muted}" Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- New view -->
                                <StackPanel Visibility="{Binding IsNewView, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="Góc nhìn" Style="{StaticResource Label}" />
                                    <ItemsControl ItemsSource="{Binding ViewPresets}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PresetChip}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.SelectViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="Yêu cầu thêm (không bắt buộc)" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding ExtraPrompt, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="14" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Results -->
                <Border Grid.Column="4" Style="{StaticResource Panel}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource VE.SecondaryButton}" MinHeight="34" Padding="12,0" Command="{Binding OpenFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource VE.IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Mở thư mục" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Kết quả" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- History -->
                        <ScrollViewer DockPanel.Dock="Bottom" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0" Height="92">
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Cursor="Hand" Margin="0,0,8,0" ToolTip="{Binding Caption}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Chrome" Width="68" Height="84" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Background="#F1F2F7">
                                                        <Border CornerRadius="6" Margin="1">
                                                            <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" /></Border.Background>
                                                        </Border>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource VE.Primary}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding SelectedResult.Caption}" FontSize="13" Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource VE.SecondaryButton}" MinHeight="34" Padding="12,0" Margin="12,0,0,0" Command="{Binding UseResultAsPersonCommand}"
                                    ToolTip="Dùng ảnh kết quả làm ảnh người mẫu để chỉnh tiếp">
                                <TextBlock Text="Chỉnh tiếp từ ảnh này" FontSize="13" />
                            </Button>
                        </StackPanel>

                        <Border Background="#1B1F27" CornerRadius="12" ClipToBounds="True">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource VE.IconFont}" FontSize="36" Foreground="#5C6375" HorizontalAlignment="Center" />
                                    <TextBlock Text="Ảnh tạo ra sẽ hiện ở đây" FontSize="13" Foreground="#9AA0B4" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Image Source="{Binding SelectedResult.Image}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="MediaStudio.Desktop.Views.VideoCreatorExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaStudio.Desktop.ViewModels"
             xmlns:views="clr-namespace:MediaStudio.Desktop.Views"
             Background="{StaticResource VE.Page}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MediaStudio.Desktop;component/Themes/VideoEditorImplicit.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style x:Key="ExportCard" TargetType="Border" BasedOn="{StaticResource VE.Card}">
                <Setter Property="CornerRadius" Value="16" />
            </Style>
            <!-- Read-only option row (value fixed by the draft) -->
            <Style x:Key="ExportOptionCard" TargetType="Border">
                <Setter Property="Background" Value="#F7F6FF" />
                <Setter Property="BorderBrush" Value="#8F86FF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,9" />
            </Style>
            <Style x:Key="HideOnSuccess" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource VE.TextSecondary}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ExportButton" TargetType="Button" BasedOn="{StaticResource VE.SecondaryButton}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="46" />
            </Style>
            <Style x:Key="StatIcon" TargetType="TextBlock" BasedOn="{StaticResource VE.Icon}">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Foreground" Value="{StaticResource VE.TextSecondary}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="22,14,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Command="{Binding BackCommand}" Style="{StaticResource VE.SecondaryButton}" MinHeight="48" Padding="18,0"
                HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.AutomationId="BackToDraftPreview">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource VE.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Quay lại chỉnh sửa" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
        </Button>


        <StackPanel Grid.Row="2" Margin="0,8,0,14">
            <TextBlock Text="Xuất video" Style="{StaticResource VE.PageTitle}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Thiết lập tùy chọn xuất để tạo video MP4 từ dự án đã chỉnh sửa."
                       Style="{StaticResource VE.PageSubtitle}" FontSize="15" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" MinWidth="360" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.05*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <!-- Preview -->
            <Border Grid.Column="0" Style="{StaticResource ExportCard}" Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Xem trước kết quả" Style="{StaticResource VE.CardTitle}" FontSize="19" VerticalAlignment="Top" />
                    <Border Grid.Row="1" Background="#151A25" CornerRadius="10" Margin="0,4,0,8" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewPosterImage" Source="{Binding PreviewPoster}" Stretch="Uniform" />
                            <MediaElement x:Name="PreviewPlayer" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                          ScrubbingEnabled="True" Opacity="0"
                                          MediaOpened="OnPreviewMediaOpened" MediaFailed="OnPreviewMediaFailed"
                                          MediaEnded="OnPreviewMediaEnded" />
                            <Border x:Name="PreviewStateOverlay" Background="#B3151A25" Padding="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="PreviewStateText" Text="Đang xác minh video preview..."
                                           Foreground="White" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="#1B2230" CornerRadius="10" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayPauseButton" Grid.Column="0" Content="&#xE768;" Click="OnPlayPause"
                                    Style="{StaticResource VE.PlayerIconButton}" FontSize="18" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,14,0">
                                <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0" Style="{StaticResource VE.PlayerSlider}"
                                        ValueChanged="OnSeekValueChanged" PreviewMouseLeftButtonDown="OnSeekStarted"
                                        PreviewMouseLeftButtonUp="OnSeekCompleted" />
                                <TextBlock x:Name="PreviewTimeLabel" Text="00:00 / 00:00" Foreground="White" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="MuteButton" Content="&#xE767;" Click="OnMute"
                                    Style="{StaticResource VE.PlayerIconButton}" />
                            <Button Grid.Column="3" Content="&#xE740;" Click="OnFullscreen" ToolTip="Toàn màn hình"
                                    Style="{StaticResource VE.PlayerIconButton}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Settings -->
            <Border Grid.Column="2" Style="{StaticResource ExportCard}" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Cài đặt xuất" Style="{StaticResource VE.CardTitle}" FontSize="21" VerticalAlignment="Center" />
                        <Button Content="Khôi phục mặc định" Command="{Binding ResetSettingsCommand}"
                                Style="{StaticResource ExportButton}" HorizontalAlignment="Right" Padding="16,0" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,6">
                            <Grid Style="{StaticResource HideOnSuccess}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Độ phân giải" Style="{StaticResource RowLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource ExportOptionCard}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource VE.IconFont}" FontSize="13"
                                                   Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource VE.Primary}" VerticalAlignment="Center" Margin="2,0,14,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding ResolutionLabel}" Foreground="{StaticResource VE.Primary}" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <Grid Style="{StaticResource HideOnSuccess}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Tốc độ khung hình" Style="{StaticResource RowLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource ExportOptionCard}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource VE.IconFont}" FontSize="13"
                                                   Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource VE.Primary}" VerticalAlignment="Center" Margin="2,0,14,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding FrameRateLabel}" Foreground="{StaticResource VE.Primary}" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <Grid Style="{StaticResource HideOnSuccess}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Định dạng file" Style="{StaticResource RowLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource ExportOptionCard}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource VE.IconFont}" FontSize="13"
                                                   Foreground="{StaticResource VE.TextSecondary}" VerticalAlignment="Center" />
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource VE.Primary}" VerticalAlignment="Center" Margin="2,0,14,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding FormatLabel}" Foreground="{StaticResource VE.Primary}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AudioCodecLabel}" Foreground="#6D63E8" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Chất lượng xuất" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,12,0,0" />
                                <StackPanel Grid.Column="1">
                                    <ComboBox ItemsSource="{Binding QualityOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Id" SelectedValue="{Binding SelectedQuality, UpdateSourceTrigger=PropertyChanged}"
                                              MinHeight="46" FontSize="16" AutomationProperties.Name="Chất lượng xuất" />
                                    <TextBlock Text="Tiêu chuẩn: CRF 21 / medium  ·  Cao: CRF 17 / slow"
                                               Foreground="{StaticResource VE.Muted}" FontSize="13" Margin="2,6,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- File name and location are settled once the export has succeeded -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Tên file" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,12,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" MinHeight="46" FontSize="16"
                                                     AutomationProperties.Name="Tên file xuất" />
                                            <Border Grid.Column="1" BorderBrush="{StaticResource VE.BorderStrong}" BorderThickness="1" CornerRadius="10"
                                                    Background="{StaticResource VE.SurfaceMuted}" Margin="6,0,0,0">
                                                <TextBlock Text=".mp4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource VE.TextSecondary}" FontSize="15" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding FileNameError}" Foreground="{StaticResource VE.Danger}" FontSize="13" Margin="2,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Vị trí lưu" Style="{StaticResource RowLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" MinHeight="46" FontSize="16"
                                             AutomationProperties.Name="Thư mục lưu video" />
                                    <Button Grid.Column="2" Content="Thay đổi..." Command="{Binding ChooseFolderCommand}"
                                            Style="{StaticResource ExportButton}" Padding="18,0" Margin="10,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding FreeSpaceLabel}" Foreground="{StaticResource VE.Muted}" FontSize="13" Margin="162,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <!-- Progress -->
                        <Border Background="#F6F6FD" BorderBrush="{StaticResource VE.Border}" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,0,0,12"
                                Visibility="{Binding IsExporting, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Đang xử lý" Foreground="{StaticResource VE.Primary}" FontSize="14" VerticalAlignment="Center" />
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource VE.PrimaryTint}" Margin="0,0,14,0">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource VE.Icon}" FontSize="17" Foreground="{StaticResource VE.Primary}" />
                                    </Border>
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource VE.Text}" FontSize="17" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                    <ProgressBar Height="12" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                                 Foreground="{StaticResource VE.Success}" Background="#E5E6F0" BorderThickness="0">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" />
                                                    <Border x:Name="PART_Track" />
                                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="6" Background="{TemplateBinding Foreground}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Foreground="{StaticResource VE.Primary}" FontSize="16"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Vui lòng giữ ứng dụng mở. Quá trình này có thể mất vài phút." Foreground="{StaticResource VE.Muted}" FontSize="13" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="Hủy" Command="{Binding CancelCommand}" Style="{StaticResource ExportButton}" HorizontalAlignment="Left"
                                MinWidth="96" Margin="0,0,0,8" Visibility="{Binding IsExporting, Converter={StaticResource BoolVisibility}}" />

                        <!-- Success -->
                        <Border Background="{StaticResource VE.SuccessTint}" BorderBrush="{StaticResource VE.SuccessBorder}" BorderThickness="1"
                                CornerRadius="14" Padding="22,20" Margin="0,0,0,8"
                                Visibility="{Binding IsSucceeded, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource VE.Success}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource VE.Icon}" FontSize="22" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Xuất video thành công!" FontSize="23" FontWeight="Bold" Foreground="{StaticResource VE.SuccessText}" />
                                        <TextBlock Text="{Binding ResultFileName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource VE.Text}" Margin="0,5,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource VE.IconFont}" FontSize="14" Foreground="{StaticResource VE.Muted}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <TextBlock Text="{Binding ResultPath}" FontSize="14" Foreground="{StaticResource VE.TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="OnCopyResultPath" ToolTip="Sao chép đường dẫn" VerticalAlignment="Bottom" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="8">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource VE.IconFont}" FontSize="15" Foreground="{StaticResource VE.TextSecondary}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="#DCF2E3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <Border Height="1" Background="{StaticResource VE.SuccessBorder}" Margin="0,18,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource StatIcon}" Margin="0,0,14,0" />
                                        <StackPanel>
                                            <TextBlock Text="Độ phân giải" FontSize="13" Foreground="{StaticResource VE.Muted}" />
                                            <TextBlock Text="{Binding ResultResolution}" FontSize="16" Foreground="{StaticResource VE.Text}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Background="{StaticResource VE.SuccessBorder}" Margin="10,2" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0">
                                        <TextBlock Text="&#xE823;" Style="{StaticResource StatIcon}" Margin="0,0,14,0" />
                                        <StackPanel>
                                            <TextBlock Text="Thời lượng" FontSize="13" Foreground="{StaticResource VE.Muted}" />
                                            <TextBlock Text="{Binding ResultDuration}" FontSize="16" Foreground="{StaticResource VE.Text}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="3" Width="1" Background="{StaticResource VE.SuccessBorder}" Margin="10,2" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="18,0,0,0">
                                        <TextBlock Text="&#xEDA2;" Style="{StaticResource StatIcon}" Margin="0,0,14,0" />
                                        <StackPanel>
                                            <TextBlock Text="Dung lượng" FontSize="13" Foreground="{StaticResource VE.Muted}" />
                                            <TextBlock Text="{Binding ResultSize}" FontSize="16" Foreground="{StaticResource VE.Text}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Command="{Binding OpenVideoCommand}" Style="{StaticResource VE.PrimaryButton}" MinHeight="50" Padding="22,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource VE.IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="Mở video" FontSize="16" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource ExportButton}" MinHeight="50" Padding="20,0" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource VE.IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="Mở thư mục" FontSize="16" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding BackCommand}" Style="{StaticResource ExportButton}" MinHeight="50" Padding="20,0" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource VE.IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="Quay lại dự án" FontSize="16" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource VE.Danger}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource VE.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExporting}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsSucceeded}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button Content="Quay lại dự án" Command="{Binding BackCommand}" Padding="20,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ExportButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSucceeded}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsExporting}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Thử kết nối lại với job hiện tại" Command="{Binding ReconnectCommand}" Margin="10,0,0,0" Padding="16,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ExportButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding NeedsJobRecovery}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Thử lại" Command="{Binding RetryCommand}" Margin="10,0,0,0" Padding="18,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ExportButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <Button Command="{Binding ExportCommand}" HorizontalAlignment="Right" MinWidth="250" MinHeight="54" Padding="24,0"
                                    AutomationProperties.AutomationId="ExportVideo">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource VE.PrimaryButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSucceeded}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsExporting}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            <DataTrigger Binding="{Binding NeedsJobRecovery}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding ExportButtonLabel}" FontSize="17" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="MediaStudio.Desktop.Views.TemplatePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MediaStudio.Desktop.Views"
             xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged"
             IsVisibleChanged="OnIsVisibleChanged"
             AutomationProperties.AutomationId="TemplatePreview">
    <UserControl.Resources>
        <views:LocalPosterImageConverter x:Key="LocalPosterImageConverter" />
    </UserControl.Resources>
    <Grid Background="#17171D" ClipToBounds="True">
        <Image Source="{Binding PosterPath, Converter={StaticResource LocalPosterImageConverter}, diag:PresentationTraceSources.TraceLevel=High}"
               Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Grid Visibility="{Binding PreviewAvailable, Converter={StaticResource BooleanToVisibilityConverter}, diag:PresentationTraceSources.TraceLevel=High}">
            <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Close"
                          Stretch="Uniform" ScrubbingEnabled="True" MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed" />
            <Border VerticalAlignment="Bottom" Background="#E6111218" Padding="14,10,14,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" ValueChanged="OnProgressChanged"
                            Style="{StaticResource VE.PlayerSlider}"
                            Height="18" VerticalAlignment="Center" AutomationProperties.Name="Tiến độ video xem trước" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayPauseButton" Content="&#xE768;" Width="38" Height="38" Click="OnPlayPauseClick"
                                AutomationProperties.Name="Phát hoặc tạm dừng video xem trước">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource VE.PlayerIconButton}">
                                    <Setter Property="Foreground" Value="#13131A" />
                                    <Setter Property="FontSize" Value="15" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White" CornerRadius="19">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Grid.Column="1" x:Name="TimeText" Text="00:00 / 00:00" FontSize="14" Foreground="White"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                        <TextBlock Grid.Column="2" x:Name="PlaybackError" Text="" FontSize="11" Foreground="#FFF0BCBC"
                                   TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Button Grid.Column="3" x:Name="MuteButton" Content="&#xE767;" Style="{StaticResource VE.PlayerIconButton}"
                                Click="OnMuteClick" ToolTip="Tắt/bật tiếng" AutomationProperties.Name="Tắt hoặc bật tiếng video xem trước" />
                        <Button Grid.Column="4" Content="&#xE740;" Style="{StaticResource VE.PlayerIconButton}" Margin="6,0,0,0"
                                Click="OnFullscreenClick" ToolTip="Toàn màn hình" AutomationProperties.Name="Xem video toàn màn hình" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="NoMediaPlaceholder" Background="#19191F" Padding="22">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PreviewAvailable, diag:PresentationTraceSources.TraceLevel=High}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasPoster, diag:PresentationTraceSources.TraceLevel=High}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                <Border Width="54" Height="54" CornerRadius="18" Background="#282633" BorderBrush="#454252"
                        BorderThickness="1" HorizontalAlignment="Center">
                    <TextBlock Text="▧" FontSize="20" Foreground="#B9B6CC" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="3,0,0,0" />
                </Border>
                <TextBlock Text="{Binding PreviewPlaceholderTitle}" FontSize="14" FontWeight="SemiBold" Foreground="White"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,15,0,0" />
                <TextBlock Text="{Binding PreviewPlaceholderDescription}"
                           FontSize="10" Foreground="#B4B2BE" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#D9161720"
                CornerRadius="6" Padding="8,5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPoster, diag:PresentationTraceSources.TraceLevel=High}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PreviewAvailable, diag:PresentationTraceSources.TraceLevel=High}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="ẢNH POSTER · TĨNH" FontSize="8" FontWeight="SemiBold" Foreground="White" />
        </Border>
    </Grid>
</UserControl>

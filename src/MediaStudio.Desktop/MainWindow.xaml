<Window x:Class="MediaStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MediaStudio.Desktop.ViewModels"
        xmlns:views="clr-namespace:MediaStudio.Desktop.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{StaticResource WorkspaceBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:UpscaleToolViewModel}">
            <views:UpscaleToolView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VectorizeToolViewModel}">
            <views:VectorizeToolView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DieCutLineToolViewModel}">
            <views:DieCutLineToolView />
        </DataTemplate>
        <Style x:Key="ToolCardIconBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#F4F3F1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ImageTools.SelectedTool}" Value="{x:Static vm:ImageToolKind.Upscale}">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UpscaleCardStyle" TargetType="Button" BasedOn="{StaticResource ToolCardButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ImageTools.SelectedTool}" Value="{x:Static vm:ImageToolKind.Upscale}">
                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                    <Setter Property="BorderBrush" Value="#B8B6F2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VectorizeCardStyle" TargetType="Button" BasedOn="{StaticResource ToolCardButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ImageTools.SelectedTool}" Value="{x:Static vm:ImageToolKind.Vectorize}">
                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                    <Setter Property="BorderBrush" Value="#B8B6F2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DieCutCardStyle" TargetType="Button" BasedOn="{StaticResource ToolCardButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ImageTools.SelectedTool}" Value="{x:Static vm:ImageToolKind.DieCutLine}">
                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                    <Setter Property="BorderBrush" Value="#B8B6F2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBackground" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#F0F0F4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.85" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageToolsNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImageToolsWorkspace}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FashionStudioNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFashionStudioWorkspace}" Value="True">
                    <Setter Property="Background" Value="#EBEAFD" />
                    <Setter Property="Foreground" Value="{StaticResource VE.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VideoEditorNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVideoEditorWorkspace}" Value="True">
                    <Setter Property="Background" Value="#EBEAFD" />
                    <Setter Property="Foreground" Value="{StaticResource VE.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FCFCFF" BorderBrush="{StaticResource VE.Border}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="16,26,16,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="62" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,0">
                        <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource VE.Primary}">
                            <Border Width="15" Height="15" BorderBrush="White" BorderThickness="2.2" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.RenderTransform><RotateTransform Angle="45" CenterX="7.5" CenterY="7.5" /></Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock Text="Media Studio" FontSize="21" FontWeight="Bold" Foreground="{StaticResource VE.Text}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="KHÔNG GIAN LÀM VIỆC" Style="{StaticResource EyebrowStyle}"
                               VerticalAlignment="Bottom" Margin="58,0,0,5" FontSize="11" Foreground="{StaticResource VE.Muted}"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Grid.Row="2" Margin="0,0,0,0">
                        <Button Style="{StaticResource VideoEditorNavButtonStyle}" Height="50"
                                AutomationProperties.AutomationId="NavVideoEditor"
                                Command="{Binding SelectWorkspaceCommand}"
                                CommandParameter="{x:Static vm:MainWorkspaceKind.VideoEditor}">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE714;" FontFamily="{StaticResource VE.IconFont}" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Video Editor" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <Button.ToolTip>Chọn mẫu video</Button.ToolTip>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Height="50" Margin="0,4,0,0" IsEnabled="False"
                                AutomationProperties.AutomationId="NavProjects">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource VE.IconFont}" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Dự án" FontSize="15" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <Button.ToolTip>Danh sách dự án chưa được kết nối.</Button.ToolTip>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Height="50" Margin="0,4,0,0" IsEnabled="False"
                                AutomationProperties.AutomationId="NavLibrary">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource VE.IconFont}" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Thư viện" FontSize="15" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <Button.ToolTip>Thư viện video chưa được kết nối.</Button.ToolTip>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Height="50" Margin="0,4,0,0" IsEnabled="False"
                                AutomationProperties.AutomationId="NavExport">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE898;" FontFamily="{StaticResource VE.IconFont}" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Xuất video" FontSize="15" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <Button.ToolTip>Xuất video được mở sau khi có dự án video.</Button.ToolTip>
                        </Button>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,12,8,7" />
                        <Button Style="{StaticResource ImageToolsNavButtonStyle}" Height="50"
                                AutomationProperties.AutomationId="NavImageTools"
                                Command="{Binding SelectWorkspaceCommand}"
                                CommandParameter="{x:Static vm:MainWorkspaceKind.ImageTools}">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE91B;" FontFamily="{StaticResource VE.IconFont}" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Image Tools" FontSize="15" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <Button.ToolTip>Công cụ hình ảnh</Button.ToolTip>
                        </Button>
                        <Button Style="{StaticResource FashionStudioNavButtonStyle}" Height="50"
                                AutomationProperties.AutomationId="NavFashionStudio"
                                Command="{Binding SelectWorkspaceCommand}"
                                CommandParameter="{x:Static vm:MainWorkspaceKind.FashionStudio}">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource VE.IconFont}" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Fashion Studio" FontSize="15" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Border Grid.Column="2" HorizontalAlignment="Right" Background="#FDECF3" CornerRadius="8" Padding="7,1" VerticalAlignment="Center">
                                    <TextBlock Text="AI" FontSize="11" FontWeight="SemiBold" Foreground="#D0457E" />
                                </Border>
                            </Grid>
                            <Button.ToolTip>Thử đồ ảo, đổi bối cảnh, đổi màu trang phục bằng Qwen-Image</Button.ToolTip>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="4" Background="#EEF6F1" CornerRadius="12" Padding="14,12">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#C17A38" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EngineConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource VE.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding EngineStatus}" FontSize="13" FontWeight="SemiBold" Foreground="#3E5446"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding EngineDescription}"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding EngineDescription}" FontSize="12" Foreground="#6F7D73" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource NavButtonStyle}" Height="38" IsEnabled="False"
                                AutomationProperties.AutomationId="NavSettings" ToolTip="Cài đặt chưa có trang cấu hình.">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource VE.IconFont}" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Cài đặt" FontSize="15" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                        <TextBlock Text="v0.1.0" FontSize="10" Foreground="{StaticResource SubtleBrush}"
                                   HorizontalAlignment="Right" Margin="0,6,4,0"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding WorkspaceHeaderHeight}" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource VE.Border}" BorderThickness="0,0,0,1">
                    <Grid Margin="28,0,22,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Media Studio" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource VE.Text}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource VE.IconFont}" FontSize="11"
                                       Foreground="{StaticResource VE.Subtle}" VerticalAlignment="Center" Margin="16,1,16,0" />
                            <TextBlock Text="{Binding WorkspaceTitle}" FontSize="17" Foreground="{StaticResource VE.Muted}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center" StrokeThickness="3">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#C17A38" />
                                        <Setter Property="Stroke" Value="#F6E3D2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EngineConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource VE.Success}" />
                                                <Setter Property="Stroke" Value="#CDEFD9" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding EngineStatus}" FontSize="15" Foreground="{StaticResource VE.Muted}" VerticalAlignment="Center" Margin="9,0,0,0"
                                       ToolTip="{Binding EngineDescription}" />
                            <Border Width="1" Height="26" Background="{StaticResource VE.Border}" Margin="22,0" />
                            <Button Style="{StaticResource VE.SecondaryButton}" Padding="16,0" MinHeight="40" IsEnabled="False" Opacity="1"
                                    Foreground="{StaticResource VE.Text}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="?" FontWeight="Bold" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Trợ giúp" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Margin="18,0,0,0" Cursor="Hand" ToolTip="{Binding Account.UserEmail}" Click="OnAccountButtonClick"
                                    AutomationProperties.AutomationId="AccountMenuButton">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Avatar" Width="38" Height="38" CornerRadius="19" Background="{StaticResource VE.PrimaryTint}">
                                            <TextBlock Text="{Binding Account.UserInitial}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource VE.Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Avatar" Property="Background" Value="#DCD8FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" MinWidth="240">
                                        <MenuItem IsEnabled="False" Header="{Binding Account.UserName}" FontWeight="SemiBold" />
                                        <MenuItem IsEnabled="False" Header="{Binding Account.UserEmail}" />
                                        <MenuItem IsEnabled="False" Header="{Binding Account.PlanLabel}" />
                                        <Separator />
                                        <MenuItem Header="Xem các gói" Click="OnShowPlansClick" />
                                        <MenuItem Header="Đăng xuất" Command="{Binding Account.LogoutCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="{StaticResource WorkspaceBrush}"
                              Visibility="{Binding IsImageToolsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                        </Style>
                    </ScrollViewer.Style>
                    <Grid Margin="28" MinHeight="740">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="90" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="Công cụ hình ảnh" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Nâng cấp ảnh, chuyển ảnh sang vector, tách nền và chỉnh alpha."
                                           Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource UpscaleCardStyle}"
                                    Command="{Binding ImageTools.SelectToolCommand}" CommandParameter="{x:Static vm:ImageToolKind.Upscale}">
                                <Grid Margin="15,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ToolCardIconBorderStyle}">
                                        <TextBlock Text="↗" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Nâng cấp ảnh" Style="{StaticResource ToolCardTitleStyle}" />
                                        <TextBlock Text="Tăng độ phân giải, giữ trọn chi tiết" Style="{StaticResource SmallTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="✓" FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding ImageTools.SelectedTool}" Value="{x:Static vm:ImageToolKind.Upscale}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource VectorizeCardStyle}"
                                    Command="{Binding ImageTools.SelectToolCommand}" CommandParameter="{x:Static vm:ImageToolKind.Vectorize}">
                                <Grid Margin="15,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ToolCardIconBorderStyle}">
                                        <TextBlock Text="◇" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Ảnh sang vector" FontSize="14" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                                    <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding ImageTools.SelectedTool}" Value="{x:Static vm:ImageToolKind.Vectorize}"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Chuyển ảnh thành đường nét sắc nét" Style="{StaticResource SmallTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="✓" FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding ImageTools.SelectedTool}" Value="{x:Static vm:ImageToolKind.Vectorize}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <Button Grid.Column="4" Style="{StaticResource DieCutCardStyle}"
                                    Command="{Binding ImageTools.SelectToolCommand}" CommandParameter="{x:Static vm:ImageToolKind.DieCutLine}">
                                <Grid Margin="15,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ToolCardIconBorderStyle}">
                                        <TextBlock Text="✂" FontFamily="Segoe UI Symbol" FontSize="19" Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Tạo đường bế" FontSize="14" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                    <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding ImageTools.SelectedTool}" Value="{x:Static vm:ImageToolKind.DieCutLine}"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Tạo viền cắt chính xác cho hình ảnh" Style="{StaticResource SmallTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="✓" FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding ImageTools.SelectedTool}" Value="{x:Static vm:ImageToolKind.DieCutLine}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </Grid>

                        <ContentControl Grid.Row="2" Margin="0,24,0,0" Content="{Binding ImageTools.ActivePage}" />
                    </Grid>
                </ScrollViewer>
                <views:FashionStudioView Grid.Row="1" DataContext="{Binding FashionStudio}"
                                         Visibility="{Binding DataContext.IsFashionStudioWorkspace, RelativeSource={RelativeSource AncestorType=Window},
                                                              Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Grid x:Name="VideoCreatorPageHost" Grid.Row="1" Background="{StaticResource VE.Page}"
                      Visibility="{Binding IsVideoEditorWorkspace,
                                           Converter={StaticResource BooleanToVisibilityConverter}}">
                    <views:VideoCreatorGalleryView x:Name="VideoCreatorGalleryHost" />
                    <views:MediaSelectionView x:Name="MediaSelectionHost" Visibility="Collapsed" />
                    <views:VideoCreatorTemplateDetailsView x:Name="VideoCreatorDetailsHost"
                                                           Visibility="Collapsed" />
                    <views:VideoCreatorProcessingView x:Name="VideoCreatorProcessingHost"
                                                      Visibility="Collapsed" />
                    <views:VideoCreatorDraftPreviewView x:Name="VideoCreatorDraftPreviewHost"
                                                         Visibility="Collapsed" />
                    <views:VideoCreatorExportView x:Name="VideoCreatorExportHost"
                                                  Visibility="Collapsed" />
                    <views:StoryResultView x:Name="StoryResultHost" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Asked when Video Editor is clicked while a template is open -->
        <Grid Visibility="{Binding IsLeaveTemplatePromptOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.AutomationId="LeaveTemplatePrompt">
            <Border Background="#66101322">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ContinueTemplateEditingCommand}" />
                </Border.InputBindings>
            </Border>
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="18" Padding="28,26,28,24">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.22" Color="#1B1640" /></Border.Effect>
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource VE.PrimaryTint}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource VE.IconFont}" FontSize="22" Foreground="{StaticResource VE.Primary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Bạn đang chỉnh sửa một mẫu" FontSize="21" FontWeight="Bold" Foreground="{StaticResource VE.Text}" Margin="0,18,0,0" />
                    <TextBlock FontSize="14" Foreground="{StaticResource VE.Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"
                               Text="Tiếp tục chỉnh sửa để giữ nguyên công việc hiện tại, hoặc hủy bỏ để quay về màn chọn mẫu. Những thay đổi chưa lưu sẽ mất khi hủy bỏ." />
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Command="{Binding DiscardTemplateEditingCommand}" Style="{StaticResource VE.SecondaryButton}" MinHeight="46"
                                AutomationProperties.AutomationId="DiscardTemplateEditing">
                            <TextBlock Text="Hủy bỏ" FontSize="15" Foreground="#D23C3C" />
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ContinueTemplateEditingCommand}" Style="{StaticResource VE.PrimaryButton}" MinHeight="46"
                                IsDefault="True" AutomationProperties.AutomationId="ContinueTemplateEditing">
                            <TextBlock Text="Tiếp tục chỉnh sửa" FontSize="15" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Plan picker (premium export) -->
        <Grid Visibility="{Binding Account.IsPlanPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.AutomationId="PlanPicker">
            <Border Background="#66101322">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding Account.ClosePlanPickerCommand}" />
                </Border.InputBindings>
            </Border>
            <Border Width="720" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="20" Padding="30,26">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.22" Color="#1B1640" /></Border.Effect>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource VE.CircleButton}" Command="{Binding Account.ClosePlanPickerCommand}" ToolTip="Đóng" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource VE.IconFont}" FontSize="11" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Nâng cấp lên Pro" FontSize="24" FontWeight="Bold" Foreground="{StaticResource VE.Text}" />
                            <TextBlock Text="{Binding Account.PlanPickerMessage}" FontSize="14" Foreground="{StaticResource VE.Muted}" TextWrapping="Wrap" Margin="0,6,20,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Account.PlanOptions}" Margin="0,22,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6,0" Padding="18,18" CornerRadius="14" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource VE.Border}" />
                                            <Setter Property="Background" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPopular}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource VE.Primary}" />
                                                    <Setter Property="Background" Value="#F7F6FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource VE.Text}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{Binding PriceText}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource VE.Primary}" />
                                            <TextBlock Text="{Binding PeriodText}" FontSize="13" Foreground="{StaticResource VE.Muted}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
                                        </StackPanel>
                                        <TextBlock Text="Xuất video và ảnh từ mọi mẫu" FontSize="13" Foreground="{StaticResource VE.TextSecondary}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                        <Button Style="{StaticResource VE.PrimaryButton}" MinHeight="40" Margin="0,16,0,0" IsEnabled="False"
                                                ToolTip="Thanh toán VNPay sẽ được mở trong bản cập nhật tới">
                                            <TextBlock Text="Sắp ra mắt" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Thanh toán qua VNPay sẽ sớm được mở. Bạn vẫn có thể chỉnh sửa mẫu này đến bước xuất."
                               FontSize="12" Foreground="{StaticResource VE.Muted}" TextWrapping="Wrap" Margin="6,18,6,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sign-in / sign-up screen -->
        <!-- DataContext is set on the element itself, so its Visibility binds relative to Account. -->
        <views:AuthView DataContext="{Binding Account}"
                        Visibility="{Binding IsAuthVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Startup: restoring the saved session -->
        <Grid Background="{StaticResource VE.Page}"
              Visibility="{Binding Account.IsStarting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Media Studio" FontSize="26" FontWeight="Bold" Foreground="{StaticResource VE.Text}" HorizontalAlignment="Center" />
                <TextBlock Text="Đang kiểm tra tài khoản…" FontSize="14" Foreground="{StaticResource VE.Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- Signed out because another machine signed in -->
        <Grid Visibility="{Binding Account.HasRemoteNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.AutomationId="SignedInElsewhereNotice">
            <Border Background="#66101322" />
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="18" Padding="28,26,28,24">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.22" Color="#1B1640" /></Border.Effect>
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="26" Background="#FFF1E8" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource VE.IconFont}" FontSize="22" Foreground="#E2622C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Đã đăng nhập trên máy khác" FontSize="21" FontWeight="Bold" Foreground="{StaticResource VE.Text}" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding Account.RemoteNotice}" FontSize="14" Foreground="{StaticResource VE.Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0" />
                    <TextBlock Text="Mỗi tài khoản chỉ dùng trên một máy. Đăng nhập lại ở đây sẽ đăng xuất máy kia." FontSize="13"
                               Foreground="{StaticResource VE.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button Command="{Binding Account.DismissNoticeCommand}" Style="{StaticResource VE.PrimaryButton}" MinHeight="46" Margin="0,22,0,0"
                            IsDefault="True">
                        <TextBlock Text="Đã hiểu" FontSize="15" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
